# ===========================
# MediKiosk Environment Config
# ===========================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (optional — app runs with in-memory store if unavailable)
MONGODB_URI=mongodb://localhost:27017/medikiosk

# Redis (optional — app runs with in-memory cache if unavailable)
REDIS_URL=redis://localhost:6379

# Demo Mode — set to true for jury demo (no external API keys needed)
DEMO_MODE=true

# AI / LLM Provider (used when DEMO_MODE=false)
AI_PROVIDER=gemini
AI_API_KEY=

# ASR Provider (used when DEMO_MODE=false)
ASR_PROVIDER=webspeech
ASR_API_KEY=

# Bhashini ASR Fallback
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=

# OCR Provider (used when DEMO_MODE=false)
OCR_PROVIDER=tesseract
OCR_API_KEY=

# Authentication
JWT_SECRET=medikiosk-sih26047-secret-change-in-production

# CORS
CLIENT_URL=http://localhost:5173

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
